+/** Navbar/menu links: internal `/docs/...` targets are flat `.html` files on
+ *  static hosts — suffix them. The docs root `/docs` stays extensionless
+ *  (directory index). External links pass through unchanged. */
+export function docsNavHref(href: string): string {
+  if (isExternalUrl(href)) return href;
+  if (href.startsWith("/docs/") && !href.endsWith(".html")) return `${href}.html`;
+  return href;
+}
