{
  "$schema": "https://cdn.jsdelivr.net/npm/@docubook/flame/docu.schema.json",
  "meta": {
    "title": "RustaSea",
    "description": "A Rust web application framework with Laravel's ergonomics and Rust's safety and performance.",
    "baseURL": "https://rustasea.github.io/docs",
    "favicon": "/docs/assets/images/favicon.ico",
    "ogImage": "/docs/assets/images/og.png"
  },
  "sidebar": {
    "context": "separator"
  },
  "themes": {
    "colors": {
      "primary": "#EE4712"
    }
  },
  "home": {
    "hero": {
      "tagline": "#RustaSea",
      "headline": "Laravel ergonomics. Rust safety.",
      "description": "RustaSea is a web application framework for Rust with expressive, elegant syntax — expressive routing, a DAG-ordered container, a fluent sqlx-backed ORM, queues, events, and AI-native tooling.",
      "actions": [
        {
          "text": "Get Started",
          "link": "/docs/getting-started/overview",
          "theme": "primary"
        },
        {
          "text": "GitHub",
          "link": "https://github.com/rustasea/framework",
          "theme": "ghost",
          "icon": "github"
        }
      ]
    },
    "features": [
      {
        "icon": "Route",
        "title": "Typed Routing",
        "description": "An axum-backed router with typed extractors, route groups, domain-aware dispatch, and proc-macro attributes.",
        "link": "/docs/guide/routing"
      },
      {
        "icon": "Database",
        "title": "Fluent ORM",
        "description": "A sqlx-backed query builder with #[derive(Model)], migrations, seeders, factories, and vector search.",
        "link": "/docs/guide/orm"
      },
      {
        "icon": "Bot",
        "title": "Agentic Development",
        "description": "Expose routes, models, config, and docs to AI coding agents over the Model Context Protocol.",
        "link": "/docs/getting-started/mcp"
      }
    ]
  },
  "navbar": {
    "logo": {
      "src": "/docs/assets/images/logo.svg",
      "alt": "RustaSea"
    },
    "logoText": "RustaSea",
    "menu": [
      {
        "title": "Home",
        "href": "/"
      },
      {
        "title": "Docs",
        "href": "/docs"
      },
      {
        "title": "GitHub",
        "href": "https://github.com/rustasea/framework"
      }
    ]
  },
  "footer": {
    "social": []
  },
  "repo": {
    "url": "https://github.com/rustasea/docs",
    "path": "blob/main/docs/{filePath}",
    "edit": true
  },
  "routes": [
    {
      "title": "Getting Started",
      "href": "/getting-started",
      "noLink": true,
      "context": {
        "icon": "Rocket",
        "title": "Getting Started"
      },
      "items": [
        { "title": "Overview", "href": "/overview" },
        { "title": "Installation", "href": "/installation" },
